                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionId\": \"PM{{runId}}\",\n  \"subjectId\": \"SUB_PM{{runId}}\",\n  \"roomId\": \"R_PM{{runId}}\",\n  \"day\": \"TUESDAY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/timetables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "timetables"
              ],
              "query": []
            }
          }
        },
        {
          "name": "TC11 Fetch the timetable of a section and day",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('only that section and day, ordered by slot', () => { const list = pm.response.json().entries; pm.expect(list.length).to.be.above(0); list.forEach((e) => { pm.expect(e.sectionId).to.eql('PM' + pm.collectionVariables.get('runId')); pm.expect(e.day).to.eql('TUESDAY'); }); const slots = list.map((e) => Number(e.slot.slice(1))); pm.expect(slots).to.eql([...slots].sort((a, b) => a - b)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/timetables?section=PM{{runId}}&day=TUESDAY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "timetables"
              ],
              "query": [
                {
                  "key": "section",
                  "value": "PM{{runId}}"
                },
                {
                  "key": "day",
                  "value": "TUESDAY"
                }
              ]
            }
          }
        },
        {
          "name": "TC12 Prevent double booking of a room",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Use any existing section other than the one that already holds the room at TUESDAY S2.",
                  "const base = pm.variables.replaceIn('{{baseUrl}}');",
                  "pm.sendRequest({ url: base + '/api/academic/sections', method: 'GET' }, (e, r) => { const s = r.json().sections.find((x) => x.id !== 'PM' + pm.collectionVariables.get('runId')); if (s) pm.collectionVariables.set('otherSection', s.id); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('names the room and slot', () => pm.expect(pm.response.json().message).to.match(/is already booked for TUESDAY slot S2\\./));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionId\": \"SEC_CSE_5A\",\n  \"subjectId\": \"SUB_PM{{runId}}\",\n  \"facultyId\": \"F_PM{{runId}}\",\n  \"roomId\": \"R_PM{{runId}}\",\n  \"day\": \"TUESDAY\",\n  \"slot\": \"S2\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/timetables",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "timetables"
              ],
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Notifications (TC15) and health (TC20)",
      "item": [
        {
