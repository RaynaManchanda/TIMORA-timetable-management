# Copy this file to .env and adjust the values.
# .env is ignored by git. Never commit real secrets.

# --- Server ---------------------------------------------------------------
PORT=3000
# Host port of the API container (docker compose).
API_PORT=3000
NODE_ENV=development

# --- PostgreSQL 16 (Docker) -------------------------------------------------
# "docker compose up -d --wait db" starts the database; Prisma and the pg pool connect to it.
POSTGRES_DB=timora_db
POSTGRES_USER=timora_user
POSTGRES_PASSWORD=change_me
# Host port of the database container. 5434 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_PORT=5434
# Used by "npm start", "npm run db:*" and Prisma when running on your machine (outside Docker).
DATABASE_URL=postgresql://timora_user:change_me@localhost:5434/timora_db?schema=public
# Set to true when connecting to a managed database that requires SSL.
DATABASE_SSL=false
# Size of the pg connection pool shared by all Prisma queries.
DATABASE_POOL_SIZE=20

# --- Security ---------------------------------------------------------------
# Required when NODE_ENV=production (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
BCRYPT_COST=12
# Per-account lockout after repeated wrong passwords.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Per-IP limit on login/register/change-password requests (0 disables it).
AUTH_RATE_WINDOW_MINUTES=15
AUTH_RATE_MAX_REQUESTS=100
# Origins (comma separated) allowed to call the API from another website. Empty = same origin only.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (1 behind nginx / a cloud load balancer).
TRUST_PROXY=0
# Milliseconds a signed-in account may be reused between database checks. 0 = check on every
# request (a disabled account or revoked token then takes effect instantly).
AUTH_CACHE_MS=0

# --- Data -------------------------------------------------------------------
# Creates the demo accounts listed in the README. Defaults to true in development, false in production.
SEED_DEMO_DATA=true
# Docker only: import data/*.xlsx when the container starts (the same file is never imported twice).
IMPORT_ON_START=true

# --- Optional integrations --------------------------------------------------
AI_API_KEY=
# Google Calendar sync. Google Cloud Console -> APIs & Services:
#   1. enable "Google Calendar API"; 2. OAuth consent screen (add your users as test users);
#   3. Credentials -> Create OAuth client ID -> "Web application";
#   4. add GOOGLE_REDIRECT_URI below to its "Authorised redirect URIs" (exactly, incl. trailing slash).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/
# Encrypts the stored Google tokens (32+ random characters). Defaults to JWT_SECRET if empty.
TOKEN_ENCRYPTION_KEY=

# --- Tests (Jest) -----------------------------------------------------------
# Started by "npm run test:db:up". The schema is rebuilt from the Prisma migrations on every run.
TEST_DATABASE_URL=postgresql://timora_test:timora_test@localhost:5433/timora_test?schema=public
